/* ========== MAIN WINDOW ========== */
QMainWindow {
    background-color: #ecf0f1;
}

/* ========== LABELS ========== */
QLabel {
    color: #2c3e50;
    font-size: 13px;
}

/* ========== BUTTONS ========== */
QPushButton {
    padding: 8px 12px;
    border-radius: 4px;
    font-weight: bold;
    font-size: 12px;
    border: none;
    transition: all 0.3s ease;
}

QPushButton:hover {
    opacity: 0.85;
}

QPushButton:pressed {
    opacity: 0.7;
}

/* ========== COMBO BOX ========== */
QComboBox {
    padding: 6px 10px;
    border: 1px solid #bdc3c7;
    border-radius: 3px;
    background-color: white;
    color: #2c3e50;
    font-size: 12px;
}

QComboBox:hover {
    border: 1px solid #95a5a6;
}

QComboBox::drop-down {
    border: none;
}

/* ========== LINE EDIT (SEARCH BOX) ========== */
QLineEdit {
    padding: 6px 10px;
    border: 1px solid #bdc3c7;
    border-radius: 3px;
    background-color: white;
    color: #2c3e50;
    font-size: 12px;
}

QLineEdit:focus {
    border: 1px solid #3498db;
    background-color: #f8f9f9;
}

/* ========== TABLE WIDGET ========== */
QTableWidget {
    gridline-color: #ecf0f1;
    background-color: white;
    alternate-background-color: #f8f9f9;
    border: 1px solid #bdc3c7;
    border-radius: 3px;
}

QTableWidget::item {
    padding: 5px;
    color: #2c3e50;
    font-size: 11px;
}

QTableWidget::item:selected {
    background-color: #3498db;
    color: white;
}

QHeaderView::section {
    background-color: #34495e;
    color: white;
    padding: 8px;
    border: none;
    font-weight: bold;
    font-size: 12px;
}

QHeaderView::section:hover {
    background-color: #2c3e50;
}

/* ========== GROUP BOX (STATISTICS) ========== */
QGroupBox {
    color: #2c3e50;
    font-weight: bold;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    margin-top: 10px;
    padding-top: 10px;
    font-size: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0px 3px 0px 3px;
}

/* ========== SCROLL BAR ========== */
QScrollBar:vertical {
    border: none;
    background-color: #ecf0f1;
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #bdc3c7;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #95a5a6;
}

QScrollBar::up-arrow:vertical {
    border: none;
}

QScrollBar::down-arrow:vertical {
    border: none;
}

/* ========== MENU & TOOLBAR ========== */
QMenuBar {
    background-color: #34495e;
    color: white;
    border-bottom: 1px solid #2c3e50;
}

QMenuBar::item:selected {
    background-color: #3498db;
}

QMenu {
    background-color: white;
    color: #2c3e50;
    border: 1px solid #bdc3c7;
}

QMenu::item:selected {
    background-color: #3498db;
    color: white;
}

/* ========== DIALOG ========== */
QDialog {
    background-color: #ecf0f1;
}

/* ========== COLOR SCHEME ========== */
/* 
Colors used:
- Primary: #3498db (Light Blue)
- Secondary: #34495e (Dark Blue-Gray)
- Success: #27ae60 (Green)
- Warning: #f39c12 (Orange)
- Danger: #e74c3c (Red)
- Background: #ecf0f1 (Light Gray)
- Text: #2c3e50 (Dark Gray)
- Border: #bdc3c7 (Light Border)
*/
